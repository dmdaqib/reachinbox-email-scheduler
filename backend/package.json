{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && prisma migrate deploy && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx src/worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev --name init",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "@types/cors": "^2.8.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.0",
    "@types/passport-google-oauth20": "^2.0.0",
    "bullmq": "^5.6.1",
    "connect-redis": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.17.0",
    "ioredis": "^5.6.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.1",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^5.9.1",
    "redis": "^4.5.1",
    "typescript": "^5.7.2",
    "uuid": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
