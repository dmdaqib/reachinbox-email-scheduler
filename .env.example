# Shared app settings
NODE_ENV=development
SESSION_SECRET=replace-with-long-random-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
PORT=4000

# Postgres / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Ethereal/Nodemailer defaults
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

# Scheduling defaults
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100

# Optional: override default sender display/credentials on first login
DEFAULT_SENDER_EMAIL=hello@ethereal.email
DEFAULT_SENDER_NAME=ReachInbox Demo Sender
